# 复制为 .env 后修改；不要提交真实密钥。
WEALTH_AGENT_DATA_DIR=data
WEALTH_AGENT_LOG_DIR=logs
WEALTH_AGENT_HTTP_PORT=8000

WEALTH_AGENT_MODEL_PROVIDER=deepseek
WEALTH_AGENT_MODEL_API_KEY=replace-with-model-api-key
WEALTH_AGENT_ANALYSIS_MODEL=deepseek-chat
WEALTH_AGENT_AGENT_MODEL=deepseek-chat
